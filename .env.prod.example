# === Base de datos ===
# En Docker Compose el host es "db" (nombre del servicio), NO localhost
DATABASE_URL=postgresql+asyncpg://fisiobot_prod:CAMBIAR_PASSWORD_FUERTE@db:5432/fisiobot
POSTGRES_DB=fisiobot
POSTGRES_USER=fisiobot_prod
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE

# === Redis ===
# En Docker Compose el host es "redis" (nombre del servicio), NO localhost
REDIS_URL=redis://:CAMBIAR_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD

# === Encriptación ===
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# === LLM ===
LLM_PROVIDER=openai       # "openai" o "gemini"
LLM_MODEL=gpt-4o-mini     # o "gemini-2.5-flash"
OPENAI_API_KEY=
GEMINI_API_KEY=            # solo si LLM_PROVIDER=gemini

# === Meta WhatsApp ===
META_APP_SECRET=

# === Google OAuth2 ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Logging ===
LOG_LEVEL=INFO
